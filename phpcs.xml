<?xml version="1.0"?>
<ruleset name="EloquentMigrations">
    <description>PSR12 aligned with PHP-CS-Fixer (@PER-CS), plus type hints checks</description>
    <config name="installed_paths" value="vendor/slevomat/coding-standard"/>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <file>app</file>
    <file>src</file>
    <file>tests</file>

    <!-- Fixtures mimic project files: untyped properties are required to override Eloquent ones -->
    <exclude-pattern>tests/Fixtures/*</exclude-pattern>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
        <!-- Align with PHP-CS-Fixer's single_line_empty_body rule from @PER-CS. -->
        <exclude name="PSR2.Classes.ClassDeclaration.OpenBraceNewLine"/>
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration.BraceOnSameLine"/>
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace.ContentBefore"/>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.UselessConstantTypeHint"/>
</ruleset>
