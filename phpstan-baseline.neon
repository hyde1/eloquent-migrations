parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Symfony\\Component\\Console\\Helper\\HelperInterface\:\:ask\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Command/AbstractCommand.php

		-
			message: '#^Cannot call method find\(\) on Symfony\\Component\\Console\\Application\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Command/AbstractCommand.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\AbstractCommand\:\:call\(\) has parameter \$arguments with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Command/AbstractCommand.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\AbstractCommand\:\:table\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/Command/AbstractCommand.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\AbstractCommand\:\:table\(\) has parameter \$contents with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Command/AbstractCommand.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\AbstractCommand\:\:table\(\) has parameter \$headers with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Command/AbstractCommand.php

		-
			message: '#^Property Hyde1\\EloquentMigrations\\Command\\AbstractCommand\:\:\$config type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Command/AbstractCommand.php

		-
			message: '#^Strict comparison using \=\=\= between string and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: src/Command/AbstractCommand.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\CreateMigration\:\:writeMigration\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/Command/CreateMigration.php

		-
			message: '#^Instantiated class Hyde1\\EloquentMigrations\\Command\\InvalidArgumentException not found\.$#'
			identifier: class.notFound
			count: 2
			path: src/Command/Init.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\Init\:\:createBin\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/Command/Init.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\Init\:\:createConfig\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/Command/Init.php

		-
			message: '#^Throwing object of an unknown class Hyde1\\EloquentMigrations\\Command\\InvalidArgumentException\.$#'
			identifier: class.notFound
			count: 2
			path: src/Command/Init.php

		-
			message: '#^Parameter \#1 \$name of method Illuminate\\Database\\Migrations\\Migrator\:\:usingConnection\(\) expects string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Command/Migrate.php

		-
			message: '#^Parameter \#1 \$name of method Illuminate\\Database\\Migrations\\DatabaseMigrationRepository\:\:setSource\(\) expects string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Command/MigrateInstall.php

		-
			message: '#^Parameter \#1 \$name of method Illuminate\\Database\\Migrations\\Migrator\:\:usingConnection\(\) expects string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Command/Rollback.php

		-
			message: '#^Argument of an invalid type array\|null supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: src/Command/RunSeed.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\RunSeed\:\:executeSeed\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/Command/RunSeed.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\RunSeed\:\:getSeedDependenciesInstances\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Command/RunSeed.php

		-
