			path: src/Command/RunSeed.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\RunSeed\:\:orderSeedsByDependencies\(\) has parameter \$seeds with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Command/RunSeed.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\RunSeed\:\:orderSeedsByDependencies\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Command/RunSeed.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\RunSeed\:\:runSeed\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/Command/RunSeed.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\RunSeed\:\:runSeed\(\) has parameter \$seed with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/Command/RunSeed.php

		-
			message: '#^Property Hyde1\\EloquentMigrations\\Command\\RunSeed\:\:\$seeds type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Command/RunSeed.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\Status\:\:getAllMigrationFiles\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Command/Status.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\Status\:\:getStatusFor\(\) has parameter \$batches with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Command/Status.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\Status\:\:getStatusFor\(\) has parameter \$ran with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Command/Status.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Command\\Status\:\:getStatusFor\(\) return type with generic class Illuminate\\Support\\Collection does not specify its types\: TKey, TValue$#'
			identifier: missingType.generics
			count: 1
			path: src/Command/Status.php

		-
			message: '#^Access to an undefined property object\:\:\$db\.$#'
			identifier: property.notFound
			count: 2
			path: src/Migrations/Migrator.php

		-
			message: '#^Call to an undefined method object\:\:getConnection\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/Migrations/Migrator.php

		-
			message: '#^Method Hyde1\\EloquentMigrations\\Seeds\\Seeder\:\:getDependencies\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Seeds/Seeder.php

		-
